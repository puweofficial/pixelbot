{
  "manifest_version": 3,
  "name": "PixelBot - Auto-Placing Bot",
  "version": "3.0.0",
  "description": "Advanced bot for pixelplanet.fun, Pixelya, Pixmap and clones with blue-purple gradient theme",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.fuckyouarkeros.fun/*",
    "*://*.pixelplanet.fun/*",
    "*://localhost/*",
    "*://*.pixmap.fun/*",
    "*://*.pixelya.fun/*",
    "*://*.wplace.live/*",
    "*://*.gplace.fun/*",
    "*://*.pixuniverse.fun/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.fuckyouarkeros.fun/*",
        "*://*.pixelplanet.fun/*",
        "*://localhost/*",
        "*://*.pixmap.fun/*",
        "*://*.pixelya.fun/*",
        "*://*.wplace.live/*",
        "*://*.gplace.fun/*",
        "*://*.pixuniverse.fun/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "PixelBot v3.0.0",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "bot-bundle.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}